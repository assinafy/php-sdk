{
    "name": "assinafy/php-sdk",
    "description": "Modern, framework-agnostic PHP SDK for the Assinafy digital signature API",
    "type": "library",
    "license": "MIT",
    "keywords": ["assinafy", "digital-signature", "e-signature", "sdk", "api-client"],
    "authors": [
        {
            "name": "Assinafy SDK Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0.2",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^11.5.56 || ^12.5 || ^13.2",
        "squizlabs/php_codesniffer": "^3.13.6 || ^4.0.2"
    },
    "suggest": {
        "monolog/monolog": "For advanced logging capabilities"
    },
    "autoload": {
        "psr-4": {
            "Assinafy\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Assinafy\\SDK\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
        "phpcs": "phpcs",
        "audit:dependencies": "@composer audit --format=plain --abandoned=fail",
        "check": [
            "@composer validate --strict --no-check-lock",
            "@test",
            "@phpstan",
            "@phpcs",
            "@audit:dependencies"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
