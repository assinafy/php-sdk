{
    "name": "assinafy/php-sdk",
    "description": "Modern PHP SDK for Assinafy digital signature API - PSR compliant and framework agnostic",
    "type": "library",
    "license": "MIT",
    "keywords": ["assinafy", "digital-signature", "e-signature", "sdk", "api-client"],
    "authors": [
        {
            "name": "Assinafy SDK Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.12.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "^7.12.1 — required by the default HTTP client (GuzzleHttpClient). Earlier 7.x releases carry CVE-2026-55568 (silent HTTPS proxy downgrade to cleartext) and CVE-2026-55767.",
        "monolog/monolog": "For advanced logging capabilities"
    },
    "autoload": {
        "psr-4": {
            "Assinafy\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Assinafy\\SDK\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
